include ~/.config/sway/maps.conf
set $scriptdir $HOME/.config/sway/scripts

font pango:DejaVu Sans Mono 8

exec swayidle -w timeout 300 'swaylock -f'

bar {
    status_command while ~/.config/sway/scripts/status.sh; do sleep 5; done
    position top
}

input type:keyboard {
	xkb_layout "us,cz"
	xkb_variant ",qwerty"
  	xkb_options "grp:win_space_toggle"
}

output "HDMI-A-2" {
    mode 1920x1080@74.986Hz
}

exec_always --no-startup-id dunst
exec_always --no-startup-id nm-applet
exec_always --no-startup-id blueman-applet

exec_always --no-startup-id swaybg -i /var/home/adamdgaf/Downloads/wallhaven-vpywv3_1920x1080.png -m fill
exec_always systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP && systemctl --user start sway-session.target
