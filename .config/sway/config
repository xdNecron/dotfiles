include ~/.config/sway/*.conf

set $scriptdir $HOME/.config/sway/scripts
font pango:DejaVu Sans Mono 8

bar {
    swaybar_command waybar    
}

input type:keyboard {
	xkb_layout "us,cz"
	xkb_variant ",qwerty"
  	xkb_options "grp:win_space_toggle"
}

output "HDMI-A-2" {
    mode 1920x1080@74.986Hz
}

exec dbus-update-activation-environment DISPLAY

exec_always --no-startup-id nm-applet
exec_always --no-startup-id blueman-applet

exec_always --no-startup-id swaybg -i /var/home/adamdgaf/Downloads/wallhaven-vpywv3_1920x1080.png -m fill

# systemd shenaningans
exec_always systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP && systemctl --user restart sway-session.target
exec_always systemctl --user add-wants sway-session.target kanshi.service
exec_always systemctl --user add-wants sway-session.target swayidle.service
exec_always systemctl --user add-wants sway-session.target dunst.service
