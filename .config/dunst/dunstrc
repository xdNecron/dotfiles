# Requirements: dunst, libnotify-{bin,dev,doc}, papirus-icon-theme
[global]
enable_posix_regex = true

width = (300, 500)
height = 300
offset = 10x10
font = "Noto Sans Mono 10"

format = <b>%a</b>\n%s\n

icon_theme = "Papirus"
enable_recursive_icon_lookup = true

[Thunderbird]
appname = "thunderbird"
