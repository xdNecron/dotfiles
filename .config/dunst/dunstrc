# Requirements: dunst, libnotify-{bin,dev,doc}, papirus-icon-theme
[global]
enable_posix_regex = true

width = (300, 500)
height = 300
offset = 10x10
font = "Noto Sans Mono 10"

format = <b>%s</b>\n%b

icon_theme = "Papirus"
enable_recursive_icon_lookup = true

background = "#100f24"
frame_color = "#8c87ed"
corner_radius = 10
frame_width = 2

[Thunderbird]
appname = "thunderbird"

[blueman]
format = <b>%a: %s</b>\n%b\n
